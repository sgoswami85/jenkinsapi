# Copy to .env (or export these) to enable live search and optional features.

# Adzuna job-search API — free tier at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: enables LLM-assisted CV summary tailoring. Leave blank to use the
# deterministic tailoring path (no network, no key needed).
ANTHROPIC_API_KEY=
